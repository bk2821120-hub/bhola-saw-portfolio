SECRET_KEY=your-secure-secret-key-here
DEBUG=True

# Database Configuration:
# 1. Automatic PostgreSQL via DATABASE_URL (used on Render, Railway, etc.):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# 2. SQLite (Default with Persistent Storage support):
DB_ENGINE=sqlite
# Optional Render Persistent Storage mount path (e.g. /var/data):
# DATA_DIR=/var/data

# 3. MySQL Configuration (Used when DB_ENGINE=mysql):
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Allowed Hosts & CSRF Origins (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost,http://127.0.0.1

# Default Admin Superuser (created automatically on first deployment)
DJANGO_SUPERUSER_USERNAME=kishanraja
DJANGO_SUPERUSER_PASSWORD=kishanraja12345
DJANGO_SUPERUSER_EMAIL=kishanraja@example.com
