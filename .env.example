SECRET_KEY=your-secure-secret-key-here
DEBUG=True

# Database Engine: 'sqlite' for zero-config testing/hosting, 'mysql' for MySQL / PythonAnywhere
DB_ENGINE=sqlite

# MySQL Database Configuration (Used when DB_ENGINE=mysql)
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app
